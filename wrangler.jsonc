{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prrweb",
	"compatibility_date": "2025-09-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "cache",
			"id": "0d48ce553bc14edf8f4681d96b62ef9c",
			"remote": true
		}
	]
}